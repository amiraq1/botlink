type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type TurnMode = 
 variant {
   auto_round_robin;
   leader_round;
 };
type Timestamp = int;
type RoomState = 
 record {
   botId: text;
   botName: text;
   groupName: text;
   isYourTurn: bool;
   maxTurns: nat;
   messages: vec Message;
   onlineNames: vec text;
   roleTitle: text;
   status: GroupStatus;
   topic: text;
   turnSeq: nat;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ReplyResult = record {accepted: bool;};
type MessageRole = 
 variant {
   bot;
   leader;
 };
type MessageId = nat;
type Message = 
 record {
   content: text;
   createdAt: Timestamp;
   groupId: GroupId;
   id: MessageId;
   role: MessageRole;
   senderBotId: BotId;
   senderColor: text;
   senderName: text;
   turnSeq: opt nat;
 };
type MemberView = 
 record {
   accentColor: text;
   agentToken: text;
   botId: BotId;
   groupId: GroupId;
   isMock: bool;
   lastSeenAt: Timestamp;
   name: text;
   online: bool;
   roleTitle: text;
 };
type MemberInput = 
 record {
   accentColor: text;
   isMock: bool;
   name: text;
   roleTitle: text;
 };
type GroupSummary = 
 record {
   createdAt: Timestamp;
   description: text;
   id: GroupId;
   maxTurns: nat;
   memberCount: nat;
   name: text;
   onlineCount: nat;
   status: GroupStatus;
   topic: text;
   turnMode: TurnMode;
   turnSeq: nat;
   updatedAt: Timestamp;
 };
type GroupStatus = 
 variant {
   completed;
   paused;
   running;
   stopped;
   waiting_for_leader;
 };
type GroupId = nat;
type GroupDetail = 
 record {
   group: Group;
   members: vec MemberView;
   messages: vec Message;
 };
type Group = 
 record {
   createdAt: Timestamp;
   currentTurnBotId: opt BotId;
   description: text;
   id: GroupId;
   maxTurns: nat;
   mockDelaySec: nat;
   name: text;
   status: GroupStatus;
   topic: text;
   turnMode: TurnMode;
   turnQueue: vec BotId;
   turnSeq: nat;
   turnStartedAt: Timestamp;
   updatedAt: Timestamp;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type CreateGroupInput = 
 record {
   description: text;
   maxTurns: nat;
   members: vec MemberInput;
   mockDelaySec: opt nat;
   name: text;
   topic: text;
   turnMode: TurnMode;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type BotId = text;
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  /// Enforces max 10 members.
  addMember: (groupId: GroupId, name: text, roleTitle: text, accentColor:
   text, isMock: bool) -> ();
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  /// 2 to 10 members enforced. Returns the new group id.
  createGroup: (input: CreateGroupInput) -> (GroupId);
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  /// Update call (not query) so it can apply a due mock reply before returning.
  getGroupDetail: (id: GroupId) -> (opt GroupDetail);
  /// Update call (not query): refreshes the member's lastSeenAt and applies a due mock reply.
  /// Returns null for an unknown token. Never exposes tokens.
  getRoomState: (token: text) -> (opt RoomState);
  isCallerAdmin: () -> (bool) query;
  listGroups: () -> (vec GroupSummary);
  pauseGroup: (groupId: GroupId) -> ();
  /// Enforces min 2 members; fixes the current turn and queue if the removed bot held them.
  removeMember: (groupId: GroupId, botId: BotId) -> ();
  resumeGroup: (groupId: GroupId) -> ();
  schema: () -> (text) query;
  sendLeaderMessage: (groupId: GroupId, "text": text) -> ();
  setMaxTurns: (groupId: GroupId, maxTurns: nat) -> ();
  setTurnMode: (groupId: GroupId, mode: TurnMode) -> ();
  skipCurrentTurn: (groupId: GroupId) -> ();
  stopGroup: (groupId: GroupId) -> ();
  /// Never traps for stale/duplicate/wrong-turn/non-running: returns { accepted = false }.
  /// Also refreshes lastSeenAt.
  submitBotReply: (token: text, expectedTurnSeq: nat, rawContent: text) ->
   (ReplyResult);
}
