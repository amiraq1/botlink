# BOTLINK — copy to .env and fill in (never commit .env).
#   cp .env.example .env

# Public port for the Go server (API + frontend).
PORT=8080

# SQLite database path inside the container (persisted via ./data volume).
DB_PATH=/data/botlink.db

# Admin login password (required — the server refuses logins without it).
# Pick a strong one, e.g. from: openssl rand -base64 24
ADMIN_PASSWORD=change-me-to-a-strong-password

# Signs the admin session cookie. Generate one per deployment:
#   openssl rand -hex 32
# If unset, the server generates an ephemeral secret on each start (all
# admin sessions are invalidated on restart) and logs a warning.
# Required (min 32 chars) when FLY_APP_NAME or APP_ENV=production is set.
SESSION_SECRET=

# AES-256-GCM encryption key for securing agent tokens at rest (min 32 chars).
#   openssl rand -hex 32
# Required at startup unless BOTLINK_DEV=1 is set.
TOKEN_ENCRYPTION_KEY=

# Set this explicitly in production deployments (Railway / Docker Compose).
# Dev only: unset it, or set APP_ENV=development, to allow ephemeral secrets.
# APP_ENV=production

# On Railway, the edge proxy replaces X-Real-IP on incoming requests from the public internet.
# Set CLIENT_IP_HEADER=X-Real-IP when deploying to Railway.
# Note: requests via *.railway.internal bypass edge sanitization.
# CLIENT_IP_HEADER=X-Real-IP

# Forwarding trust: header set by the edge (Fly sets Fly-Client-IP) and
# CIDRs of proxies allowed to forward X-Forwarded-For (comma separated).
# The first XFF element is never trusted. Set TRUSTED_PROXIES explicitly in
# production — e.g. the Caddy container IP/network, or loopback only — and do
# not publish port 8080 directly except for local development.
# TRUSTED_PROXY_HEADER=Fly-Client-IP
# TRUSTED_PROXIES=127.0.0.1/32

# Silent real bots are skipped after this many seconds (default 90).
# TURN_TIMEOUT_SEC=90
# Maximum simultaneous managed-agent provider calls (default 2, range 1-16).
# AGENT_MAX_CONCURRENCY=2
# Upper bound for maxTurns (default 500) and messages kept per group (default 2000).
# MAX_TURNS_LIMIT=500
# MESSAGE_RETENTION=2000

# Public domain for HTTPS (only used with the "https" compose profile).
# Leave empty for local development over :8080 only. In production, put the
# app behind Caddy or the Fly edge; do not expose 8080 directly.
# Set it (with a DNS A record pointing at this server) to serve
# https://<domain> via Caddy.
BOTLINK_DOMAIN=
